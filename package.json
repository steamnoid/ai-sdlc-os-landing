{
  "name": "ai-sdlc-os-landing",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test test/",
    "collect": "node scripts/ask_the_repository.mjs --repository \"${AISDLC_REPOSITORY:-../ai-sdlc-os}\" --run-the-suite --github-api \"${GITHUB_API:-https://api.github.com}\"",
    "collect:published": "node scripts/ask_the_repository.mjs --clone --ref \"${AISDLC_BRANCH:-phase-1-foundation}\" --run-the-suite --github-api \"${GITHUB_API:-https://api.github.com}\"",
    "gate": "npm run test && npm run collect && astro build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}
